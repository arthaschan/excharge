# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Data (large files)
data/*.parquet
data/*.csv
*.parquet
*.csv
!data/*_sample.csv

# Intermediate artifacts (训练日志/预测概率/中间张量等中间产物)
*.log
*.npy
*.pkl

# PDF & DOCX
*.pdf
update2/
update3/

# References (PDF 仅本地留存，不入 git)
references/*.pdf
references/

# Models
*.pth
*.pt
*.h5
models/

# IDE
.idea/
.vscode/
*.swp

# Jupyter
.ipynb_checkpoints/

# Secrets
.env
*.key
secrets/

# Large raw datasets (keep in local, not on GitHub)
*.zip
dataset /
dataset*/
充电数据*.xlsx
docs/_tmp_*.npy

# data/real 单文件均 <50MB，纳入版本控制（随代码同步，供 H100 迁移）
!data/real/*.parquet
!data/real/*.pkl

# reproduction 复现包内置中间数据（同样纳入版本控制，保证复现包自包含）
!reproduction/data/real/*.parquet
!reproduction/data/real/*.pkl
